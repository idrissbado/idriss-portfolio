generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PublicationType {
  JOURNAL_ARTICLE
  PREPRINT
  CONFERENCE_PAPER
  BOOK_CHAPTER
  RESEARCH_NOTE
  THESIS
}

enum PublicationStatus {
  PUBLISHED
  ACCEPTED
  FORTHCOMING
  SUBMITTED
  PREPRINT
  WORK_IN_PROGRESS
}

enum ResearchNoteStatus {
  DRAFT
  PUBLIC
  PRIVATE
  ARCHIVED
}

enum ProjectType {
  SOFTWARE_ENGINEERING
  ARTIFICIAL_INTELLIGENCE
  MACHINE_LEARNING
  DATA_ENGINEERING
  DATA_SCIENCE
  RESEARCH_SOFTWARE
  GIS
  STATISTICAL_COMPUTING
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
  PLANNED
}

enum Visibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String?
  passwordHash          String
  role                  String    @default("member")
  emailVerified         DateTime?
  verificationTokenHash String?
  verificationExpiresAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  source    String?
  interest  String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ForumTopic {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  category    String       @default("General")
  excerpt     String?
  content     String
  imageUrl    String?
  imageAltText String?
  authorName  String
  authorEmail String?
  published   Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  replies     ForumReply[]
}

model ForumReply {
  id          String     @id @default(cuid())
  topicId     String
  authorName  String
  authorEmail String?
  content     String
  imageUrl    String?
  imageAltText String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  topic       ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model Profile {
  id                String   @id @default(cuid())
  fullName          String
  headline          String
  tagline           String
  shortBio          String
  bio               String
  email             String?
  location          String?
  orcid             String?
  scholarUrl        String?
  githubUrl         String?
  linkedinUrl       String?
  researchStatement String?
  cvPdfUrl          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ResearchArea {
  id               String                     @id @default(cuid())
  title            String                     @unique
  slug             String                     @unique
  shortDescription String
  longDescription  String
  keywords         String[]                   @default([])
  displayOrder     Int                        @default(0)
  active           Boolean                    @default(true)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  publications     PublicationResearchArea[]
  notes            ResearchNoteResearchArea[]
  projects         ProjectResearchArea[]
}

model Tag {
  id        String            @id @default(cuid())
  name      String            @unique
  slug      String            @unique
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  notes     ResearchNoteTag[]
  projects  ProjectTag[]
  pubs      PublicationTag[]
}

model Publication {
  id                String                  @id @default(cuid())
  title             String
  slug              String                  @unique
  authors           String
  publicationYear   Int
  journal           String?
  volume            String?
  issue             String?
  pages             String?
  publisher         String?
  publicationType   PublicationType
  status            PublicationStatus
  abstract          String
  keywords          String[]                @default([])
  doi               String?
  externalUrl       String?
  pdfUrl            String?
  arxivUrl          String?
  repositoryUrl     String?
  bibtex            String?
  citation          String?
  featured          Boolean                 @default(false)
  publishedAt       DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  researchAreas     PublicationResearchArea[]
  tags              PublicationTag[]
  relatedNotes      ResearchNote[]          @relation("PublicationRelatedNotes")
  relatedProjects   Project[]               @relation("PublicationProjects")
}

model ResearchNote {
  id               String                   @id @default(cuid())
  title            String
  slug             String                   @unique
  subtitle         String?
  abstract         String
  authors          String
  date             DateTime
  lastUpdated      DateTime?
  subject          String?
  tags             ResearchNoteTag[]
  status           ResearchNoteStatus       @default(DRAFT)
  content          String
  references       String?
  pdfUrl           String?
  featured         Boolean                  @default(false)
  visibility       Visibility               @default(PUBLIC)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  researchAreas    ResearchNoteResearchArea[]
  relatedPublications Publication[]          @relation("PublicationRelatedNotes")
  relatedNotes     ResearchNoteRelation[]   @relation("NoteSource")
  reverseRelatedNotes ResearchNoteRelation[] @relation("NoteTarget")
}

model Project {
  id                String                 @id @default(cuid())
  title             String
  slug              String                 @unique
  summary           String
  description       String
  projectType       ProjectType
  status            ProjectStatus
  startDate         DateTime?
  endDate           DateTime?
  technologies      String[]               @default([])
  organization      String?
  role              String?
  problem           String?
  approach          String?
  architecture      String?
  results           String?
  technicalChallenges String?
  githubUrl         String?
  liveUrl           String?
  documentationUrl  String?
  coverImage        String?
  gallery           String[]               @default([])
  featured          Boolean                @default(false)
  visibility        Visibility             @default(PUBLIC)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  researchAreas     ProjectResearchArea[]
  tags              ProjectTag[]
  relatedPublications Publication[]        @relation("PublicationProjects")
}

model Teaching {
  id          String   @id @default(cuid())
  title       String
  institution String?
  academicYear String?
  level       String?
  description String?
  topics      String[] @default([])
  materials   String[] @default([])
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Experience {
  id          String   @id @default(cuid())
  title       String
  organization String
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Education {
  id          String   @id @default(cuid())
  degree      String
  institution String
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Award {
  id          String   @id @default(cuid())
  title       String
  issuer      String?
  date        DateTime?
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Certification {
  id          String   @id @default(cuid())
  title       String
  issuer      String?
  date        DateTime?
  credentialUrl String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Skill {
  id          String   @id @default(cuid())
  name        String   @unique
  category    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Language {
  id          String   @id @default(cuid())
  name        String   @unique
  proficiency String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MediaAsset {
  id          String   @id @default(cuid())
  filename    String
  originalName String
  mimeType    String
  size        Int
  kind        String   @default("image")
  url         String
  altText     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SocialLink {
  id          String   @id @default(cuid())
  label       String
  url         String
  type        String
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PublicationTag {
  publicationId String
  tagId         String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([publicationId, tagId])
}

model ResearchNoteTag {
  noteId   String
  tagId    String
  note     ResearchNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag      Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
}

model ProjectTag {
  projectId String
  tagId     String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
}

model PublicationResearchArea {
  publicationId String
  researchAreaId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  researchArea  ResearchArea @relation(fields: [researchAreaId], references: [id], onDelete: Cascade)

  @@id([publicationId, researchAreaId])
}

model ResearchNoteResearchArea {
  noteId        String
  researchAreaId String
  note          ResearchNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  researchArea  ResearchArea @relation(fields: [researchAreaId], references: [id], onDelete: Cascade)

  @@id([noteId, researchAreaId])
}

model ProjectResearchArea {
  projectId       String
  researchAreaId  String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  researchArea    ResearchArea @relation(fields: [researchAreaId], references: [id], onDelete: Cascade)

  @@id([projectId, researchAreaId])
}

model ResearchNoteRelation {
  sourceNoteId String
  targetNoteId String
  sourceNote   ResearchNote @relation("NoteSource", fields: [sourceNoteId], references: [id], onDelete: Cascade)
  targetNote   ResearchNote @relation("NoteTarget", fields: [targetNoteId], references: [id], onDelete: Cascade)

  @@id([sourceNoteId, targetNoteId])
}
